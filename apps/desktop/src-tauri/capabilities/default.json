{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default app-shell permissions plus local caption session commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "allow-get-capabilities",
    "allow-list-model-installs",
    "allow-get-model-download-settings",
    "allow-set-model-download-directory",
    "allow-download-model",
    "allow-import-model-files",
    "allow-get-config",
    "allow-save-config",
    "allow-session-snapshot",
    "allow-start-session",
    "allow-stop-session",
    "allow-restart-session"
  ]
}
