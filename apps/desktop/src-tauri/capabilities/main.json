{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window permissions for local caption sessions and overlay controls.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "allow-get-capabilities",
    "allow-list-providers-command",
    "allow-save-provider-command",
    "allow-fetch-provider-models",
    "allow-test-provider-command",
    "allow-list-model-installs",
    "allow-get-model-download-settings",
    "allow-set-model-download-directory",
    "allow-download-model",
    "allow-import-model-files",
    "allow-get-config",
    "allow-save-config",
    "allow-session-snapshot",
    "allow-start-session",
    "allow-stop-session",
    "allow-restart-session",
    "allow-open-caption-overlay",
    "allow-set-caption-overlay-locked",
    "allow-caption-overlay-lock-state",
    "allow-request-app-exit",
    "allow-list-records",
    "allow-list-record-devices",
    "allow-get-record",
    "allow-create-record",
    "allow-update-record",
    "allow-start-record",
    "allow-pause-record",
    "allow-resume-record",
    "allow-stop-record",
    "allow-delete-record",
    "allow-export-record",
    "allow-add-record-device",
    "allow-remove-record-device"
  ]
}
