{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SonaSub",
  "version": "0.0.0",
  "identifier": "dev.sonasub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SonaSub",
        "width": 1240,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "infoPlist": "Info.plist"
    }
  }
}
